# Origin LAN yang diizinkan Next.js dev (HMR & static chunks).
NEXT_ALLOWED_DEV_ORIGINS=192.168.1.144,10.0.92.61,100.93.151.47

POSTGRES_DB=cctv_dev
WEB_ORIGIN=http://localhost:3417
